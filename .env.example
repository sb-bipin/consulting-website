# ------------------------------------------------------------------
# Swostik Overseas - environment variables
# Copy this file to ".env" and fill in real values.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swostik_consulting"

# Secret used to sign admin session cookies (use a long random string in production)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Credentials for the seeded admin account (used only by "npm run db:seed")
ADMIN_EMAIL="admin@swostik.com"
ADMIN_PASSWORD="admin123"

# Public base URL of the site (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
